# Tradenerves Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# Polygon.io API Key (required for fetching stock data)
POLYGON_API_KEY=your_polygon_api_key_here
# MASSIVE_API_KEY=your_massive_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Path (optional - defaults to db/stocks.db)
DATABASE_PATH=db/stocks.db

# Local llama.cpp server used by `python -m tradebot`
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_MODEL=qwen
# LLAMA_SERVER_API_KEY=optional_server_key
# TRADEBOT_FINDINGS_DB_PATH=db/tradebot_findings.db
